# Copy to .env and fill in the keys you actually use.
# aisv loads .env from the working directory and does not override variables
# already set in the shell. Never commit .env.

# OpenAI Responses API (web_search tool). https://platform.openai.com/
OPENAI_API_KEY=
# Override if your account should use a different model.
AISV_OPENAI_MODEL=gpt-6.2-astra
AISV_OPENAI_BASE_URL=https://api.openai.com/v1

# Perplexity Agent API. https://docs.perplexity.ai/
PERPLEXITY_API_KEY=
# fast, low, medium, or high. Used when AISV_PERPLEXITY_MODEL is empty.
# "fast" is Perplexity's own grounded search, which is what you want when
# the thing being measured is Perplexity itself.
AISV_PERPLEXITY_EFFORT=fast
# Optional. When set, the request pins this model and does not send effort.
AISV_PERPLEXITY_MODEL=
AISV_PERPLEXITY_BASE_URL=https://api.perplexity.ai
